# Domain of the API on the IONOS VPS (an A record must point to the VPS).
API_DOMAIN=api.wichteln.example.de

# Address of the Blazor site on Cybrancee. Used for CORS and for the personal links.
APP_URL=https://wichteln.example.de

# MySQL database on Cybrancee (Plesk). Allow remote access from the VPS IP in Plesk first.
MYSQL_CONNECTION=Server=mysql.example.de;Port=3306;Database=wichteln;User=wichteln;Password=CHANGE_ME;SslMode=Preferred
# Optional, skips auto-detection at startup, e.g. 8.0.36-mysql or 10.11.6-mariadb
MYSQL_SERVER_VERSION=

# Long random string. Needed for /admin/links. Generate one with: openssl rand -base64 32
ADMIN_KEY=CHANGE_ME

# When the draw unlocks (German time).
UNLOCK_AT=2026-11-20T00:00:00+01:00
