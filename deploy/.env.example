# Copy to .env next to docker-compose.yml (/opt/apps/wichteln/deploy/.env) and fill in. Never commit .env.
# Keep values in single quotes when they contain $ or other special characters.

# The hosted MariaDB on devilbots.dev (Plesk → Databases). The API creates its tables on first start.
MYSQL_CONNECTION='Server=devilbots.dev;Port=3306;Database=devilbot_wichteln;User=devilbot_wichteln;Password=CHANGE_ME'
# Optional, skips auto-detection at startup, e.g. 10.11.6-mariadb
MYSQL_SERVER_VERSION=

# Where the Blazor client is hosted. Used for CORS and for the personal login links.
APP_URL=https://wichteln.devilbots.dev

# Long random string for the /admin endpoints. Generate one with: openssl rand -hex 32
ADMIN_KEY=

# When the draw unlocks (German time).
UNLOCK_AT=2026-11-20T00:00:00+01:00
