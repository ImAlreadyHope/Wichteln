<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Wichteln</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="wi-hero">
                <img class="wi-hero__mascot" src="img/flocke-sleep.webp" alt="" />
                <h1 class="wi-hero__title">Hier ist nichts</h1>
                <a class="wi-btn wi-btn--outline" href="./">Zur Startseite</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
